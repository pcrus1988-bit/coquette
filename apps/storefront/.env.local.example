# COQUETTE storefront local development only.
# Copy to apps/storefront/.env.local. Never commit .env.local.

NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-after-local-store-setup

# ISO 3166-1 alpha-2 country code used for Store API price/tax context.
# This is not a Medusa region ID.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=gr

# BCP-47 locales used for cart/order item localization.
# Greek may use original Medusa product content; if an el-GR translation is absent,
# Medusa falls back to the original value. Both locales must be enabled in staging.
NEXT_PUBLIC_GREEK_LOCALE=el-GR
NEXT_PUBLIC_ENGLISH_LOCALE=en-GB

# Safety guard: Medusa's system/manual payment provider is not customer-facing by
# default. Keep false in staging/production unless an explicitly approved manual
# payment workflow is intentionally being tested.
NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT=false
