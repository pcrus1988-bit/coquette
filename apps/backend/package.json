{
  "name": "@coquette/backend",
  "version": "0.1.0",
  "description": "COQUETTE Medusa commerce backend and merchant Admin",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "medusa build",
    "build:deploy": "medusa build && cd .medusa/server && npm install --omit=dev --no-package-lock",
    "start": "medusa start",
    "start:deploy": "cd .medusa/server && npm run start -- --host 0.0.0.0 --port ${PORT:-9000}",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test": "node -e \"console.log('backend tests pending')\"",
    "predeploy": "medusa db:migrate",
    "db:migrate": "medusa db:migrate",
    "db:generate:brand": "medusa db:generate brand",
    "db:generate:content": "medusa db:generate content",
    "migration:contract": "ts-node src/scripts/migration-contract-check.ts",
    "storefront:capture:contract": "ts-node src/scripts/storefront-capture-contract.ts",
    "storefront:capture": "ts-node src/scripts/capture-legacy-storefront.ts",
    "storefront:capture:operator": "ts-node src/scripts/capture-legacy-storefront-operator.ts",
    "storefront:capture:handoff": "ts-node src/scripts/operator-capture-handoff.ts",
    "storefront:capture:repair": "ts-node src/scripts/repair-operator-capture.ts",
    "storefront:capture:repair:resume": "ts-node src/scripts/resume-operator-capture-repair.ts",
    "storefront:capture:repair:finalize": "ts-node src/scripts/finalize-operator-capture-repair.ts",
    "capture-evidence-package:contract": "ts-node src/scripts/capture-evidence-package-contract.ts",
    "capture-evidence:verify": "ts-node src/scripts/verify-capture-evidence-package.ts",
    "capture-handoff:contract": "ts-node src/scripts/capture-handoff-contract.ts",
    "capture-handoff:streaming:contract": "ts-node src/scripts/streaming-capture-handoff-contract.ts",
    "capture-handoff:verify": "ts-node src/scripts/verify-capture-handoff.ts",
    "capture-handoff:intake": "ts-node src/scripts/process-capture-handoff.ts",
    "capture-handoff:intake:contract": "ts-node src/scripts/capture-handoff-intake-contract.ts",
    "dependency-provisioning:evidence": "ts-node src/scripts/dependency-provisioning-evidence.ts",
    "dependency-provisioning:evidence:contract": "ts-node src/scripts/dependency-provisioning-evidence-contract.ts",
    "indexed-recovery:contract": "ts-node src/scripts/indexed-recovery-contract.ts",
    "indexed-recovery:candidates": "ts-node src/scripts/indexed-recovery-candidates.ts",
    "recovery-candidates:contract": "ts-node src/scripts/recovery-candidates-contract.ts",
    "capture-ingestion:contract": "ts-node src/scripts/capture-ingestion-contract.ts && ts-node src/scripts/canonical-product-identity-contract.ts && ts-node src/scripts/configurable-child-sku-evidence-contract.ts && ts-node src/scripts/configurable-child-sku-supplement-contract.ts",
    "configurable-child-sku:contract": "ts-node src/scripts/configurable-child-sku-evidence-contract.ts && ts-node src/scripts/configurable-child-sku-supplement-contract.ts",
    "configurable-child-sku:probe": "ts-node src/scripts/probe-configurable-child-skus.ts",
    "product-structure:contract": "ts-node src/scripts/product-structure-contract.ts",
    "archived-product-structure:contract": "ts-node src/scripts/archived-product-structure-contract.ts",
    "import-plan:contract": "ts-node src/scripts/import-plan-contract.ts",
    "price-plan:contract": "ts-node src/scripts/price-plan-contract.ts",
    "inventory-plan:contract": "ts-node src/scripts/inventory-plan-contract.ts",
    "review-decisions:contract": "ts-node src/scripts/review-decisions-contract.ts",
    "review-application:contract": "ts-node src/scripts/review-application-contract.ts",
    "migration-input-reconciliation:contract": "ts-node src/scripts/migration-input-reconciliation-contract.ts",
    "migration-input:reconcile": "ts-node src/scripts/reconcile-migration-input.ts",
    "dependency-mapping:contract": "ts-node src/scripts/dependency-mapping-reconciliation-contract.ts",
    "dependency-mapping:reconcile": "ts-node src/scripts/reconcile-dependency-mappings.ts",
    "staging-migration-input:contract": "ts-node src/scripts/staging-migration-input-contract.ts",
    "staging-dependency-input:contract": "ts-node src/scripts/staging-dependency-input-contract.ts",
    "staging-target-policy:contract": "ts-node src/scripts/staging-target-policy-contract.ts",
    "staging-target-policy:build": "ts-node src/scripts/build-staging-target-policy.ts",
    "staging-product-execution:contract": "ts-node src/scripts/staging-target-policy-contract.ts && ts-node src/scripts/staging-product-execution-contract.ts",
    "staging-price-execution:contract": "ts-node src/scripts/staging-price-execution-contract.ts",
    "capture:ingest": "ts-node src/scripts/ingest-capture-artifact.ts",
    "staging-product-import": "medusa exec ./src/scripts/staging-product-import.ts",
    "staging-product-import:contract": "medusa exec ./src/scripts/staging-product-import-contract.ts",
    "staging-price-import": "medusa exec ./src/scripts/staging-price-import.ts",
    "staging-price-import:contract": "medusa exec ./src/scripts/staging-price-import-contract.ts",
    "admin:crud:contract": "medusa exec ./src/scripts/admin-crud-contract.ts",
    "sale:contract": "medusa exec ./src/scripts/sale-query-contract.ts",
    "staging:bootstrap": "medusa exec ./src/scripts/staging-commerce-bootstrap.ts",
    "storage:smoke": "medusa exec ./src/scripts/storage-smoke.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/caching": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "^22.22.0"
  }
}
