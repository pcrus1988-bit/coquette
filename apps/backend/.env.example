# COQUETTE backend local development only.
# Copy to apps/backend/.env and replace secrets locally. Never commit .env.

NODE_ENV=development
DATABASE_URL=postgres://coquette:coquette_local_only@localhost:55432/coquette

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

JWT_SECRET=replace-with-long-random-local-secret
COOKIE_SECRET=replace-with-long-random-local-secret

# Dedicated COQUETTE local Redis.
REDIS_URL=redis://localhost:56379
EVENTS_REDIS_URL=redis://localhost:56379
WE_REDIS_URL=redis://localhost:56379

MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Managed COQUETTE infrastructure (production/staging only).
# Supabase project ref: pijetwrxqznxaoacnakr
# Do not copy credentials from another project.
# DATABASE_URL must be supplied as a secret by the backend hosting environment.
# Prefer a direct connection for migrations when IPv6 is available; otherwise use
# the Supabase session pooler. Never expose DATABASE_URL to the storefront.

# Product/content media bucket. Public read; write credentials stay server-side.
# S3_FILE_URL=https://pijetwrxqznxaoacnakr.supabase.co/storage/v1/object/public/coquette-media
# S3_ENDPOINT=https://pijetwrxqznxaoacnakr.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=coquette-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
