# COQUETTE backend local development only.
# Copy to apps/backend/.env and replace secrets locally. Never commit .env.

NODE_ENV=development
DATABASE_URL=postgres://coquette:coquette_local_only@localhost:55432/coquette

# Public URL used by the compiled Medusa Admin to call this backend.
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

JWT_SECRET=replace-with-long-random-local-secret
COOKIE_SECRET=replace-with-long-random-local-secret

# Dedicated COQUETTE local Redis.
REDIS_URL=redis://localhost:56379
EVENTS_REDIS_URL=redis://localhost:56379
WE_REDIS_URL=redis://localhost:56379

# Local development uses shared. Hosted production uses two processes from the
# same code/artifact:
#   web/server: MEDUSA_WORKER_MODE=server, DISABLE_MEDUSA_ADMIN=false
#   worker:     MEDUSA_WORKER_MODE=worker, DISABLE_MEDUSA_ADMIN=true
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
PORT=9000

# PayPal Payment Module Provider.
# The provider is registered only when BOTH PAYPAL_CLIENT_ID and
# PAYPAL_CLIENT_SECRET are present, so normal local development and CI stay
# provider-free. Use Sandbox credentials until the production payment gate passes.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_AUTO_CAPTURE=false
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BRAND_NAME=COQUETTE

# Klarna Payments provider.
# Registration requires all four sensitive/runtime values below. Playground and
# Europe are safe defaults for COQUETTE. KLARNA_CALLBACK_BASE_URL must be the
# public HTTPS Medusa server URL; Klarna posts the authorization token to the
# signed /hooks/klarna/authorization callback generated for each payment session.
# Never expose KLARNA_PASSWORD or KLARNA_CALLBACK_SECRET to the storefront.
# KLARNA_USERNAME=
# KLARNA_PASSWORD=
# KLARNA_CALLBACK_BASE_URL=https://staging-api.example.com
# KLARNA_CALLBACK_SECRET=
# KLARNA_ENVIRONMENT=playground
# KLARNA_API_REGION=eu
# KLARNA_PURCHASE_COUNTRY=GR
# KLARNA_LOCALE=el-GR

# Managed COQUETTE infrastructure (production/staging only).
# Supabase project ref: pijetwrxqznxaoacnakr
# Do not copy credentials from another project.
# DATABASE_URL must be supplied as a secret by the backend hosting environment.
# Prefer a direct connection for migrations when IPv6 is available; otherwise use
# the Supabase session pooler. Never expose DATABASE_URL to the storefront.

# Product/content media bucket. Public read; write credentials stay server-side.
# S3_FILE_URL=https://pijetwrxqznxaoacnakr.supabase.co/storage/v1/object/public/coquette-media
# S3_ENDPOINT=https://pijetwrxqznxaoacnakr.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=coquette-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
