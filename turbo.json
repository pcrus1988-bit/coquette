{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "STORE_CORS",
    "ADMIN_CORS",
    "AUTH_CORS",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "REDIS_URL",
    "EVENTS_REDIS_URL",
    "WE_REDIS_URL",
    "PORT",
    "S3_FILE_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "PAYPAL_ENVIRONMENT",
    "PAYPAL_AUTO_CAPTURE",
    "PAYPAL_WEBHOOK_ID",
    "PAYPAL_BRAND_NAME",
    "KLARNA_USERNAME",
    "KLARNA_PASSWORD",
    "KLARNA_CALLBACK_BASE_URL",
    "KLARNA_CALLBACK_SECRET",
    "KLARNA_ENVIRONMENT",
    "KLARNA_API_REGION",
    "KLARNA_PURCHASE_COUNTRY",
    "KLARNA_LOCALE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".medusa/**"],
      "env": [
        "NODE_ENV",
        "MEDUSA_BACKEND_URL",
        "MEDUSA_WORKER_MODE",
        "DISABLE_MEDUSA_ADMIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
