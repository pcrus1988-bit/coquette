# COQUETTE CONCEPT only.
# Never copy credentials, project IDs, database URLs, API keys or secrets from another project.
# This file contains names only. Real values belong in local secret storage / deployment environments.

# Runtime
APP_ENV=local
NODE_ENV=development

# Storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=gr

# Medusa server/admin
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Database - dedicated COQUETTE PostgreSQL only
DATABASE_URL=

# Redis - dedicated COQUETTE Redis only
REDIS_URL=
EVENTS_REDIS_URL=
WE_REDIS_URL=

# S3-compatible media - dedicated COQUETTE bucket only
S3_FILE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PayPal - dedicated COQUETTE credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Klarna - dedicated COQUETTE credentials
KLARNA_ENV=playground
KLARNA_USERNAME=
KLARNA_PASSWORD=
KLARNA_REGION=eu
KLARNA_WEBHOOK_SECRET=

# Card acquiring - provider selected later
CARD_PROVIDER=
CARD_PROVIDER_API_KEY=
CARD_PROVIDER_WEBHOOK_SECRET=

# AADE / myDATA - dedicated COQUETTE credentials
AADE_ENV=sandbox
AADE_USER_ID=
AADE_SUBSCRIPTION_KEY=

# Courier integrations - dedicated COQUETTE credentials
COURIER_PROVIDER=
COURIER_API_KEY=
COURIER_API_SECRET=
COURIER_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Magento migration - read-only source credentials; never commit real values
MAGENTO_BASE_URL=
MAGENTO_USERNAME=
MAGENTO_PASSWORD=
MAGENTO_IMAGE_BASE_URL=
MAGENTO_MIGRATION_ENABLED=false
