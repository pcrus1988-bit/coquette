{
  "name": "coquette-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@coquette/backend",
    "storefront:dev": "turbo dev --filter=@coquette/storefront",
    "capture:coquette": "pnpm --filter @coquette/backend storefront:capture:handoff",
    "capture:coquette:repair": "pnpm --filter @coquette/backend storefront:capture:repair",
    "capture:coquette:repair:resume": "pnpm --filter @coquette/backend storefront:capture:repair:resume",
    "capture:coquette:repair:finalize": "pnpm --filter @coquette/backend storefront:capture:repair:finalize",
    "capture:coquette:verify": "pnpm --filter @coquette/backend capture-handoff:verify",
    "capture:coquette:intake": "pnpm --filter @coquette/backend capture-handoff:intake",
    "capture:coquette:dependencies": "pnpm --filter @coquette/backend dependency-provisioning:evidence",
    "capture:coquette:reanalyse": "pnpm --filter @coquette/backend capture:ingest",
    "capture:coquette:staging-slice": "pnpm --filter @coquette/backend staging-target-policy:build",
    "capture:coquette:staging-dependencies": "pnpm --filter @coquette/backend staging-slice:dependency-evidence",
    "capture:coquette:staging-dependencies:provision": "pnpm --filter @coquette/backend staging-slice:dependency-provision",
    "capture:coquette:staging-dependencies:rollback": "pnpm --filter @coquette/backend staging-slice:dependency-rollback",
    "capture:coquette:staging-env-preflight": "pnpm --filter @coquette/backend staging:runtime-env-preflight",
    "capture:coquette:staging-storage-recovery-rehearsal": "pnpm --filter @coquette/backend staging:storage-recovery-rehearsal",
    "capture:coquette:child-skus": "pnpm --filter @coquette/backend configurable-child-sku:probe",
    "railway-build-backend": "pnpm --filter @coquette/backend build:deploy",
    "railway-start-backend": "pnpm --filter @coquette/backend start:deploy",
    "railway-predeploy-backend": "pnpm --filter @coquette/backend predeploy",
    "infra:up": "docker compose -f infra/local/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/local/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @coquette/backend db:migrate",
    "db:generate:brand": "pnpm --filter @coquette/backend db:generate:brand",
    "db:generate:content": "pnpm --filter @coquette/backend db:generate:content"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
